// Copy this file to Config/Secrets.xcconfig (which is git-ignored) and fill in
// your Supabase project's values from Dashboard → Project Settings → API.
//
// Only the public "anon" key belongs here. It is safe to ship in the app
// because every table is protected by row-level security. NEVER put the
// service_role key in the app.
//
// Note: xcconfig treats "//" as a comment, so the URL is split into scheme and
// host. For a local `supabase start` use: SUPABASE_SCHEME = http and
// SUPABASE_HOST = 127.0.0.1:54321

SUPABASE_SCHEME = https
SUPABASE_HOST = YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY
